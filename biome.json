{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "formatter": { "indentStyle": "space", "indentWidth": 2 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "jsxQuoteStyle": "double" }
  },
  "files": {
    "includes": ["**", "!!node_modules", "!!.expo", "!!android", "!!ios"]
  },
  "linter": {
    "rules": { "preset": "recommended", "a11y": { "noSvgWithoutTitle": "off" } }
  }
}
